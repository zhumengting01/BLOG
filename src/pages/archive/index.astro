---
import IndexPage from "@/layouts/IndexPage.astro";
import {site} from "@/consts";
import getPostsByYear from "@/utils/getPostsByYear";
import getPostsByMonth from "@/utils/getPostsByMonth";
import {sortPostsByDate} from "@/utils/sortPostsByDate";
import Pagination from "@/components/Pagination.astro";
import {getCollectionByName} from "@/utils/getCollectionByName";
import getUrl from "@/utils/getUrl";

import dayjs from "dayjs";
import {ceil, divide} from "lodash-es";

let posts = await getCollectionByName("blog");
let totalPage = ceil(divide(posts.length, site.archivePageSize));
let postCountByYear = Object.fromEntries(
  Object.entries(getPostsByYear(posts)).map(([year, yearlyPosts]) => [
    year,
    yearlyPosts.length,
  ]),
);

let sortedPosts = sortPostsByDate(posts);
sortedPosts = sortedPosts.splice(0, site.archivePageSize);
let resultPosts = getPostsByYear(sortedPosts);
---

<IndexPage>
  {
    Object.keys(resultPosts)
      .sort((a, b) => Number(b) - Number(a))
      .map((year) => (
        <div>
          <div class="text-2xl font-extrabold my-4">
            {year}
            <span class="ml-2 text-base font-normal text-skin-base/60">
              {postCountByYear[year]} 篇
            </span>
          </div>
          {Object.keys(getPostsByMonth(resultPosts[year]))
            .sort((a, b) => Number(b) - Number(a))
            .map((month) => (
              <div class="mb-5">
                <div class="mb-2 text-lg font-bold">{month} 月</div>
                <ul>
                  {getPostsByMonth(resultPosts[year])[month].map((post) => (
                    <li style="list-style-type: disc;" class="ml-4 my-2">
                      <a href={getUrl('/') + post.collection + '/' + post.id}>
                        <span class="mr-4">
                          {dayjs(post.data.date).format("YYYY-MM-DD")}
                        </span>
                        {post.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
        </div>
      ))
  }
  <Pagination currentPage={1} totalPage={totalPage} prefixUrl={getUrl("/archive/")}/>
</IndexPage>
