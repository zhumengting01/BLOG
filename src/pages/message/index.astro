---
import IndexPage from "@/layouts/IndexPage.astro";
import {t} from '@/i18n/utils'
---

<IndexPage frontmatter={{comment: false, donate: false,}}>
  <section class="message-wall" aria-labelledby="message-title">
    <div class="stars" aria-hidden="true">
      <span class="star star--one">✦</span>
      <span class="star star--two">✧</span>
      <span class="star star--three">✦</span>
      <span class="star star--four">✧</span>
      <span class="star star--five">✦</span>
      <span class="star star--six">✧</span>
      <span class="star star--seven">✦</span>
      <span class="star star--eight">✧</span>
      <span class="star star--nine">✦</span>
      <span class="dot dot--one"></span>
      <span class="dot dot--two"></span>
      <span class="dot dot--three"></span>
      <span class="dot dot--four"></span>
      <span class="crescent crescent--one">☾</span>
      <span class="crescent crescent--two">☽</span>
      <span class="heart heart--one">♡</span>
      <span class="heart heart--two">♥</span>
    </div>
    <div class="message-wall__heading">
      <h1 id="message-title">{t('message.welcome')}</h1>
      <p>{t('message.welcomeTips')}</p>
    </div>

    <div class="message-wall__notes">
      <p class="note note--star">当乌云散去，自有漫天繁星。</p>
      <p class="note note--lucky">所有的幸运，都是努力埋下的伏笔。</p>
      <p class="note note--time">你只管努力，剩下的交给时间。</p>
      <p class="note note--flower">慢一点没关系，花会沿途盛开。</p>
      <p class="note note--ordinary">把平凡的日子过好，就是最了不起的浪漫。</p>
      <p class="note note--echo">愿所有奔赴都值得，所有等待都有回音。</p>
      <p class="note note--clear">生活不会一直难，乌云之后总有晴空。</p>
      <p class="note note--strength">在无人问津的日子里，悄悄积蓄力量。</p>
      <p class="note note--persist">那些看似不起波澜的日复一日，会突然在某一天让人看到坚持的意义。</p>
    </div>
  </section>
</IndexPage>

<style>
  .message-wall {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.5rem 0 0;
    overflow: hidden;
  }

  .message-wall__heading {
    margin: 0 0 1.8rem 0.7rem;
  }

  .message-wall__heading h1 {
    margin: 0;
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .message-wall__heading p {
    margin: 0.5rem 0 0;
    color: rgb(var(--color-text-dodge));
    font-size: 0.9rem;
  }

  .message-wall__notes {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    align-content: space-between;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    height: clamp(26rem, calc(100vh - 12rem), 34rem);
    padding: 0.5rem 0.7rem 1.5rem;
  }

  .note {
    position: relative;
    margin: 0;
    padding: 0.75rem 1rem;
    color: rgb(var(--color-text));
    background: rgb(var(--color-fill-secondary));
    border: 1px solid rgb(var(--color-border) / 0.38);
    border-radius: 0.25rem 0.95rem 0.4rem 0.8rem;
    box-shadow: 0.28rem 0.35rem 0 rgb(var(--color-border) / 0.12);
    font-size: 0.96rem;
    font-style: italic;
    line-height: 1.6;
    white-space: nowrap;
  }

  .note::before {
    position: absolute;
    top: -0.3rem;
    left: 0.95rem;
    width: 2rem;
    height: 0.55rem;
    content: '';
    background: rgb(var(--color-border) / 0.22);
    transform: rotate(-5deg);
  }

  .note--star { transform: rotate(-1.3deg); }
  .note--lucky { margin-top: 0.35rem; transform: rotate(1.1deg); }
  .note--time { transform: rotate(0.7deg); }
  .note--flower { margin-top: 0.25rem; transform: rotate(-1.8deg); }
  .note--ordinary { transform: rotate(1deg); }
  .note--echo { margin-top: 0.25rem; transform: rotate(-0.7deg); }
  .note--clear { transform: rotate(-1deg); }
  .note--strength { margin-top: 0.3rem; transform: rotate(1.6deg); }
  .note--persist { margin: 0.4rem auto 0; transform: rotate(-0.5deg); }

  .stars {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .star {
    position: absolute;
    color: rgb(var(--color-text-active) / 0.58);
    font-family: Georgia, serif;
    line-height: 1;
  }

  .star--one { top: 1.3rem; right: 8%; font-size: 1.15rem; transform: rotate(12deg); }
  .star--two { top: 8.7rem; left: 4%; font-size: 0.85rem; transform: rotate(-18deg); }
  .star--three { top: 17.5rem; right: 3%; font-size: 1.35rem; transform: rotate(16deg); }
  .star--four { top: 26rem; left: 10%; font-size: 0.75rem; transform: rotate(-8deg); }
  .star--five { bottom: 2.6rem; right: 13%; font-size: 1rem; transform: rotate(22deg); }
  .star--six { bottom: 6rem; left: 2%; font-size: 0.7rem; transform: rotate(-14deg); }
  .star--seven { top: 6.4rem; right: 31%; font-size: 0.72rem; transform: rotate(-8deg); }
  .star--eight { top: 20rem; left: 46%; font-size: 0.82rem; transform: rotate(22deg); }
  .star--nine { bottom: 9rem; right: 39%; font-size: 0.8rem; transform: rotate(-18deg); }

  .dot {
    position: absolute;
    width: 0.3rem;
    height: 0.3rem;
    background: rgb(var(--color-border) / 0.5);
    border-radius: 50%;
  }

  .dot--one { top: 11.5rem; left: 31%; }
  .dot--two { top: 24rem; right: 18%; width: 0.2rem; height: 0.2rem; }
  .dot--three { bottom: 11rem; left: 17%; width: 0.24rem; height: 0.24rem; }
  .dot--four { bottom: 4rem; left: 56%; width: 0.18rem; height: 0.18rem; }

  .crescent,
  .heart {
    position: absolute;
    font-family: Georgia, serif;
    line-height: 1;
  }

  .crescent {
    color: rgb(var(--color-border) / 0.58);
    font-size: 1.1rem;
  }

  .crescent--one { top: 14.5rem; right: 10%; transform: rotate(18deg); }
  .crescent--two { bottom: 6.8rem; left: 28%; font-size: 0.92rem; transform: rotate(-12deg); }

  .heart {
    color: rgb(var(--color-text-active) / 0.42);
    font-size: 0.95rem;
  }

  .heart--one { top: 25.5rem; left: 7%; transform: rotate(-14deg); }
  .heart--two { bottom: 3rem; right: 6%; font-size: 0.72rem; transform: rotate(16deg); }

  @media (max-width: 719px) {
    .message-wall { padding-top: 1.25rem; }
    .message-wall__heading { margin-left: 0; }
    .message-wall__notes {
      display: flex;
      flex-direction: column;
      height: auto;
      gap: 1.15rem;
      padding: 0.35rem 0 1rem;
    }
    .note {
      width: min(100%, 34rem);
      margin: 0;
      transform: none;
      white-space: normal;
    }
    .note:nth-child(even) { align-self: flex-end; }
    .star--three { top: 23rem; }
    .star--four { top: 36rem; }
    .star--five { bottom: 1rem; }
    .star--seven,
    .star--eight,
    .star--nine,
    .dot,
    .crescent,
    .heart { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .note { transform: none; }
  }
</style>
